---
import Layout from '../layouts/Layout.astro'
export const prerender = true;
---

<Layout 
  title="Links — StiefundGlücklich"
  description="Alle wichtigen Links von Sally Matthes — Coach für Bonusmamas in Patchworkfamilien."
  canonical="https://stiefundgluecklich.de/links/"
  noHeader={true}
>
  <section class="min-h-screen bg-white py-10 md:py-14">
    <div class="mx-auto px-5 max-w-[500px]">
      <div class="text-center mb-10">
        <img 
          src="/images/sally-biolink.jpg" 
          alt="Sally Matthes — Coach für Bonusmamas" 
          class="w-20 h-20 md:w-24 md:h-24 rounded-full mx-auto mb-4 object-cover shadow-md"
          loading="eager"
        />
        <h1 class="font-serif text-lg md:text-xl text-primary mb-1">StiefundGlücklich</h1>
        <p class="text-sm text-muted-foreground">Sally Matthes · Bonusmama & systemischer Coach</p>
      </div>

      <div class="text-center mb-8">
        <h2 class="font-serif text-[1.6rem] md:text-[2.1rem] leading-[1.32] text-foreground mb-5">
          Du willst in deiner Patchworkfamilie nicht länger nur funktionieren?
        </h2>
        <p class="text-base text-muted-foreground leading-relaxed">
          Meine persönliche 1:1-Begleitung ist zurück. Finde mit der Bewerbung direkt heraus, ob sie gerade zu dir passt.
        </p>
      </div>

      <div class="mb-8">
        <a href="/1zu1-bewerbung"
          class="block w-full bg-primary hover:bg-primary/90 text-primary-foreground text-center px-6 py-4 rounded-full font-semibold transition-colors text-base">
          Für die 1:1-Begleitung bewerben
        </a>
        <p class="text-xs text-muted-foreground text-center mt-3">
          Unverbindlich · dauert etwa 5 Minuten
        </p>
      </div>

      <div class="border-t border-primary/20 pt-8">
        <div class="text-center mb-6">
          <h3 class="font-serif text-xl text-foreground mb-3">
            Du möchtest direkt selbst loslegen?
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Wähle die Unterstützung, die gerade zu deiner Situation passt.
          </p>
        </div>

        <div class="space-y-4">
          <a
            href="/beyondbonus/"
            class="block w-full rounded-2xl border border-primary/25 px-5 py-5 transition-colors hover:bg-primary/5"
          >
            <span class="block font-serif text-xl text-foreground mb-1">BeyondBonus</span>
            <span class="block text-sm text-muted-foreground leading-relaxed mb-3">
              Der umfassende Kurs für deinen klaren Platz in der Patchworkfamilie.
            </span>
            <span class="text-sm font-semibold text-primary">BeyondBonus ansehen · 497 €</span>
          </a>

          <a
            href="/its-bundle/"
            class="block w-full rounded-2xl border border-primary/25 px-5 py-5 transition-colors hover:bg-primary/5"
          >
            <span class="block font-serif text-xl text-foreground mb-1">ITS Bundle</span>
            <span class="block text-sm text-muted-foreground leading-relaxed mb-3">
              Drei kompakte Trainings für Zugehörigkeit, klare Gespräche und gesunde Grenzen.
            </span>
            <span class="text-sm font-semibold text-primary">ITS Bundle ansehen · 59 €</span>
          </a>
        </div>
      </div>

      <div class="border-t border-primary/20 pt-8 mt-8 text-center">
        <h3 class="font-serif text-xl text-foreground mb-3">
          Du möchtest erst einmal kostenlos starten?
        </h3>
        <p class="text-sm text-muted-foreground leading-relaxed mb-5">
          Break the Cycle zeigt dir, welches unsichtbare Muster eure Patchwork-Beziehung gerade blockiert.
        </p>
        <a
          href="/bonusmama-check"
          id="links-check-cta"
          class="block w-full border border-primary text-primary hover:bg-primary/5 text-center px-6 py-4 rounded-full font-semibold transition-colors text-base"
        >
          Break the Cycle starten
        </a>
      </div>

      <div class="text-center mt-10">
        <p class="text-sm text-muted-foreground mb-3">
          Über 1.000 Bonusmamas hören <span class="text-foreground font-medium">Bonusgeflüster</span>.
        </p>
        <a
          href="https://open.spotify.com/show/5wNKGzYsF6PMxuCRmUu5Pm"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-11 h-11 items-center justify-center rounded-full border border-primary/40 text-primary hover:bg-primary/5 transition-colors"
          aria-label="Bonusgeflüster auf Spotify hören"
          title="Bonusgeflüster auf Spotify hören"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const source = params.get('source');
  const checkCta = document.getElementById('links-check-cta');

  if (source && checkCta) {
    checkCta.setAttribute('href', `/bonusmama-check?source=${encodeURIComponent(source)}`);
  }
</script>
