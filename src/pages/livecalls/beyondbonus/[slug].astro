---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { getAccessSnapshot } from '../../../lib/auth/grants';
import { loadUserGrants } from '../../../lib/auth/load-grants';
import { getBeyondBonusLivecallFromStore } from '../../../lib/beyondbonus/admin-content';

const runtimeEnv = (Astro.locals as any).runtime?.env;
const grants = await loadUserGrants(Astro);
const access = getAccessSnapshot(grants, 'beyondbonus');

if (!access.livecalls) {
  return Astro.redirect('/members?error=no-access');
}

const { slug } = Astro.params;
const recording = slug ? await getBeyondBonusLivecallFromStore(runtimeEnv, slug) : null;
const progressKey = `livecall::${slug || ''}`;

if (!recording) {
  return Astro.redirect('/livecalls/beyondbonus');
}
---

<Layout
  title={`${recording.title} | BeyondBonus Livecall`}
  canonical={`https://stiefundgluecklich.de/livecalls/beyondbonus/${recording.slug}/`}
  description={recording.description}
  noHeader={true}
>
  <section class="py-14 md:py-24" data-progress-key={progressKey}>
    <div class="container mx-auto px-4 sm:px-5 md:px-6 max-w-5xl">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-7">
        <a href="/livecalls/beyondbonus" class="inline-flex items-center text-sm text-muted-foreground hover:text-primary transition-colors">
          ← Zurück zu den Livecalls
        </a>
        <a href="/members" class="inline-flex w-fit px-4 py-2 text-sm font-medium border border-border hover:bg-secondary/40 transition-colors">
          Zum Dashboard
        </a>
      </div>

      <header class="space-y-4 mb-8">
        <p class="text-sm uppercase tracking-[0.2em] text-muted-foreground">{recording.dateLabel} · {recording.durationLabel}</p>
        <div class="space-y-3">
          <h1 class="font-serif text-3xl md:text-4xl leading-tight">{recording.title}</h1>
          <p class="text-base text-muted-foreground leading-relaxed max-w-3xl">{recording.description}</p>
        </div>
      </header>

      <article class="border border-border bg-background shadow-[0_10px_24px_rgba(0,0,0,0.03)] overflow-hidden">
        <div class="aspect-video bg-secondary/40">
          <video
            class="h-full w-full bg-black"
            controls
            playsinline
            preload="metadata"
            src={recording.mediaUrl}
            controlsList="nodownload"
          >
            Dein Browser kann dieses Video nicht direkt abspielen.
          </video>
        </div>
        <div class="p-5 md:p-6 space-y-3">
          <p class="text-sm text-muted-foreground leading-relaxed">
            Tipp fürs Handy: Starte das Video, drehe dein Handy quer und nutze den Vollbild-Button im Player.
          </p>
          <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border/80 pt-4">
            <p class="text-sm text-muted-foreground" data-livecall-state>Diese Aufzeichnung ist noch nicht abgeschlossen.</p>
            <button type="button" class="inline-flex px-5 py-3 bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity" data-toggle-complete>
              Als erledigt markieren
            </button>
          </div>
        </div>
      </article>
    </div>

    <script is:inline>
      const key = document.querySelector('[data-progress-key]')?.getAttribute('data-progress-key');
      const button = document.querySelector('[data-toggle-complete]');
      const state = document.querySelector('[data-livecall-state]');
      const readProgress = () => {
        try {
          return JSON.parse(localStorage.getItem('bb-progress-v1') || '{}');
        } catch {
          return {};
        }
      };
      const writeProgress = (progress) => localStorage.setItem('bb-progress-v1', JSON.stringify(progress));
      const refresh = () => {
        const progress = readProgress();
        const done = key && progress[key];
        if (state) state.textContent = done ? 'Diese Aufzeichnung ist abgeschlossen.' : 'Diese Aufzeichnung ist noch nicht abgeschlossen.';
        if (button) button.textContent = done ? 'Als nicht erledigt markieren' : 'Als erledigt markieren';
      };
      const syncProgress = async () => {
        const progress = readProgress();
        refresh();
        try {
          const response = await fetch('/api/members/progress', { credentials: 'same-origin' });
          const payload = await response.json();
          if (!response.ok || !Array.isArray(payload.progress)) return;
          payload.progress.forEach((entry) => {
            if (entry.lesson_key) progress[entry.lesson_key] = Boolean(entry.completed);
          });
          writeProgress(progress);
          refresh();
        } catch {}
      };
      button?.addEventListener('click', async () => {
        if (!key) return;
        const progress = readProgress();
        progress[key] = !progress[key];
        writeProgress(progress);
        refresh();
        try {
          const response = await fetch('/api/members/progress', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lessonKey: key, completed: Boolean(progress[key]) }),
          });
          if (!response.ok) throw new Error('progress-save-failed');
        } catch {
          progress[key] = !progress[key];
          writeProgress(progress);
          refresh();
        }
      });
      syncProgress();
    </script>
  </section>
</Layout>
