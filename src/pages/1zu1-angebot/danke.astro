---
import Layout from '../../layouts/Layout.astro'
export const prerender = true;
---

<Layout title="Danke für deine Angebotsannahme" description="Deine Annahme der persönlichen 1:1-Begleitung wurde übermittelt." noHeader={true} noindex={true}>
  <section class="pt-24 md:pt-32 pb-20 min-h-[78vh]">
    <div class="container mx-auto px-5 md:px-6">
      <div class="max-w-[680px] mx-auto text-center">
        <p class="text-sm font-medium tracking-wider text-primary uppercase mb-4">Angebot angenommen</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl leading-tight mb-6">Danke für dein Vertrauen.</h1>
        <p class="text-lg text-muted-foreground leading-relaxed mb-9">Deine Angaben wurden übermittelt. Du erhältst deine Rechnung und die Vertragsunterlagen per E-Mail. Es wurde nichts automatisch abgebucht.</p>
        <div class="bg-cream border border-border p-6 md:p-8 text-left">
          <h2 class="text-2xl mb-4">So geht es weiter</h2>
          <ol class="space-y-3 text-muted-foreground">
            <li><strong class="text-foreground">1.</strong> Prüfe dein Postfach auf Rechnung und Vertragsunterlagen.</li>
            <li><strong class="text-foreground">2.</strong> Überweise den Gesamtbetrag oder die erste vereinbarte Rate.</li>
            <li><strong class="text-foreground">3.</strong> Nach bestätigtem Zahlungseingang erhältst du BeyondBonus, dein Onboarding und die Buchung für den ersten 90-Minuten-Termin.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (() => {
      if (typeof window.gtag === 'function') window.gtag('event', 'one_to_one_offer_accepted_viewed', { event_category: 'one_to_one_offer_acceptance' });
      if (typeof window.posthog !== 'undefined') window.posthog.capture('one_to_one_offer_accepted_viewed');
    })();
  </script>
</Layout>
